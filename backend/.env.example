# local, dynamodb, or s3
COURTVISION_CACHE_BACKEND=local
COURTVISION_CACHE_TTL_SECONDS=604800

# Required when COURTVISION_CACHE_BACKEND=dynamodb
COURTVISION_DYNAMODB_TABLE=courtvision-cache

# Required when COURTVISION_CACHE_BACKEND=s3
COURTVISION_S3_CACHE_BUCKET=courtvision-cache-your-name
COURTVISION_S3_CACHE_PREFIX=cache
